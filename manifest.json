{
  "manifest_version": 3,
  "name": "Workflow Automator: Macro Recorder, Record & Replay",
  "version": "1.0.0",
  "description": "Automate repetitive tasks, auto-fill forms, and record web workflows with a no-code macro recorder.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "https://workflow-automator-dashboard.vercel.app/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://*:*/*",
    "https://*:*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Workflow Automator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "content/playback-capture.js",
        "content/page-interceptor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
